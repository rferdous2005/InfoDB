 document.getElementById('vulnerability-lookup-logo').src = '/static/img/VL-hori-coul.png';<EOL>        document.getElementById('btnThemeSwitch').setAttribute('title', 'Switch to dark theme');<EOL>      } else {<EOL>        document.getElementById('btnThemeSwitch').innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-sun-fill" viewBox="0 0 16 16"><path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/></svg>';<EOL>        document.getElementById('vulnerability-lookup-logo').src = '/static/img/VL-hori-white-coul.png';<EOL>        document.getElementById('btnThemeSwitch').setAttribute('title', 'Switch to light theme');<EOL>      }<EOL><EOL><EOL>      document.addEventListener("DOMContentLoaded", function() {<EOL>        // Footer "Show welcome banner": only offered once the hero has been<EOL>        // dismissed; clicking clears the preference and returns to the home page.<EOL>        const restoreWrap = document.getElementById("restoreHeroWrap");<EOL>        const restore = document.getElementById("restoreHero");<EOL>        if (restoreWrap && restore) {<EOL>          if (getCookie("vl_hero_hidden") === '1') {<EOL>            restoreWrap.classList.remove("d-none");<EOL>          }<EOL>          restore.addEventListener("click", function () {<EOL>            document.cookie = "vl_hero_hidden=; path=/; max-age=0; SameSite=Lax";<EOL>          });<EOL>        }<EOL><EOL>        document.getElementById('btnThemeSwitch').addEventListener('click',()=>{<EOL>          if (document.documentElement.getAttribute('data-bs-theme') == 'dark') {<EOL>            document.documentElement.setAttribute('data-bs-theme','light')<EOL>            document.getElementById('btnThemeSwitch').innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-moon-stars-fill" viewBox="0 0 16 16"><path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"/><path d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.73 1.73 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.73 1.73 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.73 1.73 0 0 0 1.097-1.097zM13.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732l-.774-.258a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z"/></svg>';<EOL>            document.getElementById('vulnerability-lookup-logo').src = '/static/img/VL-hori-coul.png';<EOL>            document.getElementById('btnThemeSwitch').setAttribute('title', 'Switch to dark theme');<EOL>            document.cookie = "theme=light; path=/; SameSite=Strict";<EOL>          }<EOL>          else {<EOL>            document.documentElement.setAttribute('data-bs-theme','dark');<EOL>            document.getElementById('btnThemeSwitch').innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-sun-fill" viewBox="0 0 16 16"><path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/></svg>';<EOL>            document.getElementById('vulnerability-lookup-logo').src = '/static/img/VL-hori-white-coul.png';<EOL>            document.getElementById('btnThemeSwitch').setAttribute('title', 'Switch to light theme');<EOL>            document.cookie = "theme=dark; path=/; SameSite=Strict";<EOL>          }<EOL>        });<EOL><EOL>        // Navbar search: themed vendor autocomplete, matching the hero and the<EOL>        // search page. Vendor suggestions are fetched once at least three<EOL>        // characters are typed and rendered in a styled, keyboard-navigable list.<EOL>        (function () {<EOL>          const input = document.getElementById("freetext_search");<EOL>          const box = document.getElementById("navbar_suggestions");<EOL>          if (!input || !box) return;<EOL><EOL>          const form = input.closest("form");<EOL>          const group = input.closest(".input-group");<EOL>          const VENDOR_ICON = "\n\u003csvg class=\"bi\" width=\"1em\" height=\"1em\" fill=\"currentColor\"\u003e\n    \n    \n    \u003cuse xlink:href=\"/bootstrap/static/icons/bootstrap-icons.svg#building\"/\u003e\n\u003c/svg\u003e";<EOL>          let items = [];<EOL>          let active = -1;<EOL>          let timer;<EOL><EOL>          // Anchor the fixed dropdown to the input group so it sits below the<EOL>          // navbar search field regardless of the dropdown menu's clipping.<EOL>          function position() {<EOL>            const r = group.getBoundingClientRect();<EOL>            box.style.left = r.left + "px";<EOL>            box.style.top = (r.bottom + 6) + "px";<EOL>            box.style.width = r.width + "px";<EOL>          }<EOL><EOL>          function escapeHtml(s) {<EOL>            return s.replace(/[&<>"']/g, c => ({<EOL>              "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"<EOL>            }[c]));<EOL>          }<EOL><EOL>          function highlight(vendor, term) {<EOL>            const i = vendor.toLowerCase().indexOf(term.toLowerCase());<EOL>            if (i === -1) return escapeHtml(vendor);<EOL>            return escapeHtml(vendor.slice(0, i))<EOL>              + "<mark>" + escapeHtml(vendor.slice(i, i + term.length)) + "</mark>"<EOL>              + escapeHtml(vendor.slice(i + term.length));<EOL>          }<EOL><EOL>          function close() {<EOL>            box.classList.add("d-none");<EOL>            box.innerHTML = "";<EOL>            items = [];<EOL>            active = -1;<EOL>            input.setAttribute("aria-expanded", "false");<EOL>          }<EOL><EOL>          function setActive(i) {<EOL>            items.forEach((el, idx) => {<EOL>              const on = idx === i;<EOL>              el.classList.toggle("active", on);<EOL>              el.setAttribute("aria-selected", on ? "true" : "false");<EOL>            });<EOL>            active = i;<EOL>          }<EOL><EOL>          function choose(vendor) {<EOL>            input.value = vendor;<EOL>            close();<EOL>            form.submit();<EOL>          }<EOL><EOL>          function render(vendors, term) {<EOL>            box.innerHTML = "";<EOL>            items = vendors.map((vendor, idx) => {<EOL>              const li = document.createElement("li");<EOL>              li.className = "vl-autocomplete-item";<EOL>              li.setAttribute("role", "option");<EOL>              li.dataset.vendor = vendor;<EOL>              li.innerHTML = '<span class="vl-ac-icon">' + VENDOR_ICON + "</span>"<EOL>                + "<span>" + highlight(vendor, term) + "</span>";<EOL>              li.addEventListener("mousedown", (e) => { e.preventDefault(); choose(vendor); });<EOL>              li.addEventListener("mouseenter", () => setActive(idx));<EOL>              box.appendChild(li);<EOL>              return li;<EOL>            });<EOL>            if (items.length) {<EOL>              position();<EOL>              box.classList.remove("d-none");<EOL>              input.setAttribute("aria-expanded", "true");<EOL>            } else {<EOL>              close();<EOL>            }<EOL>          }<EOL><EOL>          input.addEventListener("input", function () {<EOL>            clearTimeout(timer);<EOL>            const term = this.value.trim();<EOL>            if (term.length < 3) { close(); return; }<EOL>            timer = setTimeout(function () {<EOL>              fetch("/api/browse/?vendor=" + encodeURIComponent(term))<EOL>                .then(r => r.json())<EOL>                .then(vendors => {<EOL>                  // The API returns every substring match in arbitrary order, so<EOL>                  // rank locally: exact match first, then prefix matches, then by<EOL>                  // length and alphabetically, before capping the visible list.<EOL>                  const q = term.toLowerCase();<EOL>                  const rank = v => { const lv = v.toLowerCase(); return lv === q ? 0 : lv.startsWith(q) ? 1 : 2; };<EOL>                  vendors.sort((a, b) =><EOL>                    rank(a) - rank(b) || a.length - b.length || a.localeCompare(b));<EOL>                  render(vendors.slice(0, 15), term);<EOL>                })<EOL>                .catch(err => console.error("Error fetching vendors:", err));<EOL>            }, 250);<EOL>          });<EOL><EOL>          input.addEventListener("keydown", function (e) {<EOL>            if (box.classList.contains("d-none") || !items.length) return;<EOL>            if (e.key === "ArrowDown") {<EOL>              e.preventDefault();<EOL>              setActive((active + 1) % items.length);<EOL>            } else if (e.key === "ArrowUp") {<EOL>              e.preventDefault();<EOL>              setActive((active - 1 + items.length) % items.length);<EOL>            } else if (e.key === "Enter" && active >= 0) {<EOL>              e.preventDefault();<EOL>              choose(items[active].dataset.vendor);<EOL>            } else if (e.key === "Escape") {<EOL>              close();<EOL>            }<EOL>          });<EOL><EOL>          document.addEventListener("click", function (e) {<EOL>            if (!form.contains(e.target)) close();<EOL>          });<EOL><EOL>          // Keep the fixed dropdown aligned while it is open.<EOL>          function reposition() { if (!box.classList.contains("d-none")) position(); }<EOL>          window.addEventListener("scroll", reposition, true);<EOL>          window.addEventListener("resize", reposition);<EOL>        })();<EOL><EOL><EOL>        // Show the button when scrolled down<EOL>        const scrollToTopBtn = document.getElementById("scrollToTopBtn");<EOL>        const vlTopbar = document.getElementById("vlTopbar");<EOL><EOL>        function onScroll() {<EOL>          const y = document.documentElement.scrollTop;<EOL>          const show = y > 500;<EOL>          scrollToTopBtn.classList.toggle("show", show);<EOL>          scrollToTopBtn.classList.toggle("d-none", !show);<EOL>          if (vlTopbar) vlTopbar.classList.toggle("is-scrolled", y > 4);<EOL>        }<EOL><EOL>        window.addEventListener("scroll", () => requestAnimationFrame(onScroll));<EOL>        onScroll();<EOL><EOL>        scrollToTopBtn.addEventListener("click", () => {<EOL>          window.scrollTo({ top: 0, behavior: "smooth" });<EOL>        });<EOL>      });<EOL>    </script><EOL>  </body><EOL></html>"
