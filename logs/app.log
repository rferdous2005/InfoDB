yId('btnThemeSwitch').innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-sun-fill" viewBox="0 0 16 16"><path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/></svg>';<EOL>            document.getElementById('vulnerability-lookup-logo').src = '/static/img/VL-hori-white-coul.png';<EOL>            document.getElementById('btnThemeSwitch').setAttribute('title', 'Switch to light theme');<EOL>            document.cookie = "theme=dark; path=/; SameSite=Strict";<EOL>          }<EOL>        });<EOL><EOL>        // Navbar search: themed vendor autocomplete, matching the hero and the<EOL>        // search page. Vendor suggestions are fetched once at least three<EOL>        // characters are typed and rendered in a styled, keyboard-navigable list.<EOL>        (function () {<EOL>          const input = document.getElementById("freetext_search");<EOL>          const box = document.getElementById("navbar_suggestions");<EOL>          if (!input || !box) return;<EOL><EOL>          const form = input.closest("form");<EOL>          const group = input.closest(".input-group");<EOL>          const VENDOR_ICON = "\n\u003csvg class=\"bi\" width=\"1em\" height=\"1em\" fill=\"currentColor\"\u003e\n    \n    \n    \u003cuse xlink:href=\"/bootstrap/static/icons/bootstrap-icons.svg#building\"/\u003e\n\u003c/svg\u003e";<EOL>          let items = [];<EOL>          let active = -1;<EOL>          let timer;<EOL><EOL>          // Anchor the fixed dropdown to the input group so it sits below the<EOL>          // navbar search field regardless of the dropdown menu's clipping.<EOL>          function position() {<EOL>            const r = group.getBoundingClientRect();<EOL>            box.style.left = r.left + "px";<EOL>            box.style.top = (r.bottom + 6) + "px";<EOL>            box.style.width = r.width + "px";<EOL>          }<EOL><EOL>          function escapeHtml(s) {<EOL>            return s.replace(/[&<>"']/g, c => ({<EOL>              "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"<EOL>            }[c]));<EOL>          }<EOL><EOL>          function highlight(vendor, term) {<EOL>            const i = vendor.toLowerCase().indexOf(term.toLowerCase());<EOL>            if (i === -1) return escapeHtml(vendor);<EOL>            return escapeHtml(vendor.slice(0, i))<EOL>              + "<mark>" + escapeHtml(vendor.slice(i, i + term.length)) + "</mark>"<EOL>              + escapeHtml(vendor.slice(i + term.length));<EOL>          }<EOL><EOL>          function close() {<EOL>            box.classList.add("d-none");<EOL>            box.innerHTML = "";<EOL>            items = [];<EOL>            active = -1;<EOL>            input.setAttribute("aria-expanded", "false");<EOL>          }<EOL><EOL>          function setActive(i) {<EOL>            items.forEach((el, idx) => {<EOL>              const on = idx === i;<EOL>              el.classList.toggle("active", on);<EOL>              el.setAttribute("aria-selected", on ? "true" : "false");<EOL>            });<EOL>            active = i;<EOL>          }<EOL><EOL>          function choose(vendor) {<EOL>            input.value = vendor;<EOL>            close();<EOL>            form.submit();<EOL>          }<EOL><EOL>          function render(vendors, term) {<EOL>            box.innerHTML = "";<EOL>            items = vendors.map((vendor, idx) => {<EOL>              const li = document.createElement("li");<EOL>              li.className = "vl-autocomplete-item";<EOL>              li.setAttribute("role", "option");<EOL>              li.dataset.vendor = vendor;<EOL>              li.innerHTML = '<span class="vl-ac-icon">' + VENDOR_ICON + "</span>"<EOL>                + "<span>" + highlight(vendor, term) + "</span>";<EOL>              li.addEventListener("mousedown", (e) => { e.preventDefault(); choose(vendor); });<EOL>              li.addEventListener("mouseenter", () => setActive(idx));<EOL>              box.appendChild(li);<EOL>              return li;<EOL>            });<EOL>            if (items.length) {<EOL>              position();<EOL>              box.classList.remove("d-none");<EOL>              input.setAttribute("aria-expanded", "true");<EOL>            } else {<EOL>              close();<EOL>            }<EOL>          }<EOL><EOL>          input.addEventListener("input", function () {<EOL>            clearTimeout(timer);<EOL>            const term = this.value.trim();<EOL>            if (term.length < 3) { close(); return; }<EOL>            timer = setTimeout(function () {<EOL>              fetch("/api/browse/?vendor=" + encodeURIComponent(term))<EOL>                .then(r => r.json())<EOL>                .then(vendors => {<EOL>                  // The API returns every substring match in arbitrary order, so<EOL>                  // rank locally: exact match first, then prefix matches, then by<EOL>                  // length and alphabetically, before capping the visible list.<EOL>                  const q = term.toLowerCase();<EOL>                  const rank = v => { const lv = v.toLowerCase(); return lv === q ? 0 : lv.startsWith(q) ? 1 : 2; };<EOL>                  vendors.sort((a, b) =><EOL>                    rank(a) - rank(b) || a.length - b.length || a.localeCompare(b));<EOL>                  render(vendors.slice(0, 15), term);<EOL>                })<EOL>                .catch(err => console.error("Error fetching